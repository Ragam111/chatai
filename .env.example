# คัดลอกเป็น .env แล้วเติมค่าจริง — .env ถูก gitignore ไว้ (ห้าม commit ค่าจริง)

# ลายเซ็น session (บังคับเมื่อเปิดออกนอก localhost) — สุ่มยาวๆ เช่น:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=

# URL สาธารณะของเว็บ (ใช้ประกอบ redirect_uri ที่ต้องตรงกับที่ลงทะเบียนไว้กับ provider)
BASE_URL=http://127.0.0.1:8500

# Google OAuth — ลงทะเบียนที่ https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: <BASE_URL>/auth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub OAuth — ลงทะเบียนที่ https://github.com/settings/developers (New OAuth App)
#   Authorization callback URL: <BASE_URL>/auth/github/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# พอร์ต/โฮสต์ (ไม่ตั้งก็ได้)
HOST=127.0.0.1
PORT=8500

# ---------- แชต / LLM ----------
# เลือก backend: echo (default, ไม่มี LLM) | ollama | openai
CHAT_BACKEND=echo
CHAT_MODEL=qwen2.5-coder:1.5b
CHAT_TIMEOUT=120
# เมื่อ CHAT_BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11434
# เมื่อ CHAT_BACKEND=openai (หรือ endpoint ที่เข้ากันได้)
OPENAI_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
